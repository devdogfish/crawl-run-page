        "seg": { "type": "enum", "label": "Status", "default": "all", "values": ["all", "new", "fixed"] },
        "pri": { "type": "list", "label": "Priority", "default": "all", "extra": ["all"], "values": ["P1", "P2", "P3", "P4"] },
        "cat": { "type": "list", "label": "Category", "default": "all", "extra": ["all"], "values": ["accessibility", "performance", "seo", "security"] },
        "markup": { "type": "enum", "label": "Markup", "default": "all", "values": ["all", "shared", "page"] },
        "auditRule": { "type": "rule", "label": "Audit rule" },
        "el": { "type": "text", "label": "Element", "default": "all" },
        "from": { "type": "text", "label": "Return path", "default": "" }
      }
    },
    {
      "id": "issues", "path": "/:site/issues", "label": "Issues",
      "params": {
        "crawl": { "type": "crawl", "label": "Crawl" },
        "vs": { "type": "crawl", "label": "Compared with", "extra": ["none"] },
        "q": { "type": "text", "label": "Search", "default": "" },
        "cat": { "type": "list", "label": "Category", "default": "all", "extra": ["all"], "values": ["accessibility", "performance", "seo", "security"],
          "labels": { "accessibility": "Accessibility", "performance": "Performance", "seo": "SEO & canonicals", "security": "Security & compliance" } },
        "pri": { "type": "list", "label": "Priority", "default": "all", "extra": ["all"], "values": ["P1", "P2", "P3", "P4"] },
        "markup": { "type": "enum", "label": "Markup", "default": "all", "values": ["all", "shared", "page"], "labels": { "shared": "Shared markup", "page": "Page-specific markup" } },
        "type": { "type": "enum", "label": "Page type", "default": "all", "values": ["all", "article", "research", "news", "podcast", "video", "event", "people", "other"] },
        "year": { "type": "enum", "label": "Year", "default": "all", "values": ["all", "2026", "2025", "2024", "2023", "2022", "2021", "2020", "2019", "2018", "2017", "2016", "none"] },
        "sub": { "type": "text", "label": "Folder", "default": "" },
        "auditRule": { "type": "rule", "label": "Audit rule" },
        "el": { "type": "text", "label": "Element", "default": "all" },
        "sort": { "type": "enum", "label": "Sort", "default": "priority", "values": ["priority", "pages", "elements", "new"] },
        "seg": { "type": "enum", "label": "Status", "default": "all", "values": ["all", "new", "fixed"] }
      }
    },
    {
      "id": "rule", "path": "/:site/issues/:ruleId", "label": "Rule", "path_params": { "ruleId": { "type": "rule" } },
      "params": {
        "crawl": { "type": "crawl", "label": "Crawl" },
        "vs": { "type": "crawl", "label": "Compared with", "extra": ["none"] },
        "q": { "type": "text", "label": "Search", "default": "" },
        "el": { "type": "text", "label": "Element", "default": "all" },
        "type": { "type": "enum", "label": "Page type", "default": "all", "values": ["all", "article", "research", "news", "podcast", "video", "event", "people", "other"] },
        "year": { "type": "enum", "label": "Year", "default": "all", "values": ["all", "2026", "2025", "2024", "2023", "2022", "2021", "2020", "2019", "2018", "2017", "2016", "none"] },
        "sub": { "type": "text", "label": "Folder", "default": "" },
        "pri": { "type": "list", "label": "Priority", "default": "all", "extra": ["all"], "values": ["P1", "P2", "P3", "P4"] },
        "cat": { "type": "list", "label": "Category", "default": "all", "extra": ["all"], "values": ["accessibility", "performance", "seo", "security"] },
        "markup": { "type": "enum", "label": "Markup", "default": "all", "values": ["all", "shared", "page"] },
        "from": { "type": "text", "label": "Return path", "default": "" },
        "seg": { "type": "enum", "label": "Status", "default": "all", "values": ["all", "new", "fixed"] }
      }
    },
    {
      "id": "analytics", "path": "/:site/analytics", "label": "Analytics",
      "params": {
        "v": { "type": "enum", "label": "View", "default": "dashboard", "values": ["dashboard", "report", "board", "explorer"] },
        "range": { "type": "enum", "label": "Range", "default": "30", "values": ["7", "30", "all"], "labels": { "7": "7 days", "30": "30 days", "all": "All" } }
      }
    },
    { "id": "settings", "path": "/:site/settings", "label": "Settings", "params": {} }
  ]
