# Copy to .env (git-ignored). Everything is optional in dev: defaults point at the Codex shim (pnpm dev:codex).

# The corporate AI gateway (OpenAI-compatible). THIS IS ALL THAT CHANGES FOR PRODUCTION.
AI_BASE_URL=http://127.0.0.1:8787/v1
AI_API_KEY=dev
AI_CHAT_MODEL=codex          # Ask AI (needs tool calling)
AI_NAV_MODEL=codex           # Cmd+K navigation: a small, fast model with JSON output

# Dev adapter for the Core: the Vite dev server serving src/lib/proto-api.ts
PROTO_URL=http://localhost:5173/__proto

# Where url-map.json lives (default: the repo root)
# URL_MAP=../url-map.json

# Codex shim only (dev/codex_openai.py)
# CODEX_MODEL=gpt-5.6-terra
# CODEX_EFFORT=medium
